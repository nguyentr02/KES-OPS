# Neon Postgres pooled connection string (Neon dashboard → Connect → "Pooled").
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Secret for the encrypted login session cookie. Must be ≥ 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
